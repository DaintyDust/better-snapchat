{
  "compilerOptions": {
    "jsx": "react",
    "target": "es2019",
    "module": "commonjs",
    "paths": {
      "@/*": ["./src/*"],
      "@hooks/*": ["./src/script/hooks/*"],
      "@lib/*": ["./src/script/lib/*"],
      "@app-types/*": ["./src/types/*"],
      "@utils/*": ["./src/script/utils/*"],
      "@modules/*": ["./src/script/modules/*"],
      "@devmodules/*": ["./src/script/devmodules/*"],
      "@theme/*": ["./src/script/theme/*"]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "typeRoots": ["node_modules/@types", "node_modules/web-ext-types"],
    "types": ["chrome"],
    "noUncheckedIndexedAccess": true
  },
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
