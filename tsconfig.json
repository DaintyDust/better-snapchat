{
  "compilerOptions": {
    "jsx": "react",
    "target": "es2019",
    "module": "commonjs",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@hooks/*": [
        "src/script/hooks/*"
      ],
      "@lib/*": [
        "src/script/lib/*"
      ],
      "@app-types/*": [
        "src/types/*"
      ],
      "@utils/*": [
        "src/script/utils/*"
      ],
      "@modules/*": [
        "src/script/modules/*"
      ]
    },
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "typeRoots": [
      "node_modules/@types",
      "node_modules/web-ext-types"
    ],
    "noUncheckedIndexedAccess": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts"
  ]
}