{
  "name": "BetterSnap - Make Snapchat Web Better",
  "version": "1.5.3",
  "description": "Screenshot Freely, Save Media, Bypass Presence Detection and more!",
  "scripts": {
    "start": "rm -rf ./public/build/ && node ./scripts/dev.js",
    "build": "npm run build:chrome",
    "manifest-lint": "addons-linter public/",
    "lint": "eslint && prettier --check \"src/**/*.{ts,tsx}\"",
    "lint:fix": "prettier --write --end-of-line auto \"src/**/*.{ts,tsx}\"",
    "build:chrome": "rm -rf ./public/build/ && node ./scripts/chrome.js",
    "build:firefox": "rm -rf ./public/build/ && node ./scripts/firefox.js",
    "build:userscript": "rm -rf ./public/build/ && node ./scripts/userscript.js",
    "package": "npm run package:chrome",
    "package:chrome": "bash -lc \"rm -rf ./public/build/ && npm run build:chrome && mkdir -p ./dist && ./node_modules/.bin/cross-zip ./public ./dist/better-snapchat-chrome-v${npm_package_version}.zip\"",
    "package:firefox": "bash -lc \"rm -rf ./public/build/ && npm run build:firefox && mkdir -p ./dist && ./node_modules/.bin/cross-zip ./public ./dist/better-snapchat-firefox-v${npm_package_version}.zip\"",
    "package:userscript": "bash -lc \"rm -rf ./public/build/ && npm run build:userscript && mkdir -p ./dist && cp ./public/build/userscript.js ./dist/better-snapchat-userscript-v${npm_package_version}.js\"",
    "package:all": "npm run package:chrome && npm run package:firefox && npm run package:userscript"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daintydust/better-snapchat.git"
  },
  "author": "dev@daintydust.dev, donnieacolston@gmail.com",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/daintydust/better-snapchat/issues"
  },
  "homepage": "https://github.com/daintydust/better-snapchat#readme",
  "dependencies": {
    "@mantine/core": "^9.0.1",
    "@mantine/hooks": "^9.0.1",
    "@tabler/icons-react": "^3.33.0",
    "clsx": "^2.1.1",
    "cookies-js": "^1.2.3",
    "eventemitter3": "^5.0.1",
    "fast-deep-equal": "^3.1.3",
    "fuse.js": "^7.0.0",
    "lodash.throttle": "^4.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.29.0",
    "@types/chrome": "^0.2.0",
    "@types/lodash.throttle": "^4.1.9",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.0.1",
    "@types/ua-parser-js": "^0.7.39",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "addons-linter": "^8.1.0",
    "chokidar": "^4.0.3",
    "cross-zip-cli": "^1.0.0",
    "dotenv": "^17.2.0",
    "esbuild": "^0.27.3",
    "esbuild-plugin-alias": "^0.2.1",
    "esbuild-plugin-import-glob": "^0.1.1",
    "esbuild-sass-plugin": "^3.3.1",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.2.0",
    "lightningcss": "^1.32.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "reconnecting-websocket": "^4.4.0",
    "typescript": "^6.0.2",
    "ws": "^8.18.2"
  }
}
